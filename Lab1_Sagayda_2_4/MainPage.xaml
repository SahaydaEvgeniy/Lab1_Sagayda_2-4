<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Lab1_Sagayda_2_4.MainPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:models="clr-namespace:Lab1_Sagayda_2_4.Models"
    xmlns:viewModels="clr-namespace:Lab1_Sagayda_2_4.ViewModels"
    x:DataType="viewModels:StudentViewModel"
    Title="Особистий кабінет студента">

    <Shell.TitleView>
        <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
            <Label
                FontAttributes="Bold"
                Text="Особистий кабінет студента"
                VerticalOptions="Center"
                LineBreakMode="TailTruncation" />

            <Button
                Grid.Column="1"
                Text="Налаштування"
                Command="{Binding OpenSettingsCommand}">
                <VisualStateManager.VisualStateGroups>
                    <VisualStateGroup x:Name="CommonStates">
                        <VisualState x:Name="Normal">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#512BD4, Dark=#AC99EA}" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark=#242424}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="PointerOver">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#3E209F, Dark=#C8BAF2}" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark=#242424}" />
                            </VisualState.Setters>
                        </VisualState>
                        <VisualState x:Name="Pressed">
                            <VisualState.Setters>
                                <Setter Property="BackgroundColor" Value="{AppThemeBinding Light=#321A80, Dark=#9580D5}" />
                                <Setter Property="TextColor" Value="{AppThemeBinding Light=White, Dark=#242424}" />
                            </VisualState.Setters>
                        </VisualState>
                    </VisualStateGroup>
                </VisualStateManager.VisualStateGroups>
            </Button>
        </Grid>
    </Shell.TitleView>

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="18">

            <Label
                FontAttributes="Bold"
                FontSize="26"
                HorizontalOptions="Center"
                Text="Особистий кабінет студента" />

            <Label Text="ПІБ студента" />

            <Label
                Text="{Binding AppState.StorageError}"
                IsVisible="{Binding AppState.HasStorageError}"
                TextColor="{AppThemeBinding Light=Red, Dark=LightCoral}" />

            <Entry
                Placeholder="Введіть ПІБ"
                Text="{Binding FullName, Mode=TwoWay}" />

            <Label Text="Група" />

            <Entry
                Placeholder="Введіть групу"
                Text="{Binding Group, Mode=TwoWay}" />

            <Label Text="Середній бал" />

            <Slider
                Maximum="5"
                Minimum="0"
                Value="{Binding AverageScore, Mode=TwoWay}" />

            <Label
                FontSize="18"
                Text="{Binding AverageScore,
                               Mode=OneWay,
                               StringFormat='Середній бал: {0:F2}'}" />

            <Button
                Command="{Binding AddStudentCommand}"
                Text="Додати студента" />

            <Label
                FontAttributes="Bold"
                FontSize="22"
                Text="Список студентів" />

            <Grid HeightRequest="300">
                <CollectionView
                    ItemsSource="{Binding Students, Mode=OneWay}">

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="models:Student">

                            <Border
                                Margin="0,5"
                                Padding="12"
                                Stroke="Gray"
                                StrokeShape="RoundRectangle 8">

                                <Grid
                                    RowDefinitions="Auto,Auto"
                                    RowSpacing="10"
                                    ColumnDefinitions="2*,*,Auto"
                                    ColumnSpacing="10">

                                    <Label
                                        Grid.Column="0"
                                        FontAttributes="Bold"
                                        Text="{Binding FullName}" />

                                    <Label
                                        Grid.Column="1"
                                        Text="{Binding Group,
                                                       StringFormat='Група: {0}'}" />

                                    <Label
                                        Grid.Column="2"
                                        Text="{Binding AverageScore,
                                                       StringFormat='Бал: {0:F2}'}" />

                                    <Button
                                        Grid.Row="1"
                                        HorizontalOptions="Start"
                                        Command="{Binding OpenDetailsCommand, Source={RelativeSource AncestorType={x:Type viewModels:StudentViewModel}}, x:DataType=viewModels:StudentViewModel}"
                                        CommandParameter="{Binding .}"
                                        Text="Детальніше" />

                                    <Button
                                        Grid.Row="1"
                                        Grid.Column="1"
                                        Grid.ColumnSpan="2"
                                        HorizontalOptions="End"
                                        BackgroundColor="Red"
                                        TextColor="White"
                                        Command="{Binding DeleteStudentCommand, Source={RelativeSource AncestorType={x:Type viewModels:StudentViewModel}}, x:DataType=viewModels:StudentViewModel}"
                                        CommandParameter="{Binding .}"
                                        Text="Видалити" />

                                </Grid>
                            </Border>

                        </DataTemplate>
                    </CollectionView.ItemTemplate>

                </CollectionView>

                <!-- Keep the empty message outside the native collection's EmptyView. -->
                <Label
                    HorizontalOptions="Center"
                    VerticalOptions="Center"
                    InputTransparent="True"
                    IsVisible="False"
                    Text="Список студентів поки порожній"
                    TextColor="{AppThemeBinding Light=#6E6E6E, Dark=#C8C8C8}">
                    <Label.Triggers>
                        <DataTrigger
                            TargetType="Label"
                            Binding="{Binding Students.Count}"
                            Value="0">
                            <Setter Property="IsVisible" Value="True" />
                        </DataTrigger>
                    </Label.Triggers>
                </Label>
            </Grid>

            <Border
                Padding="15"
                Stroke="Gray"
                StrokeShape="RoundRectangle 10">

                <Label
                    FontAttributes="Bold"
                    FontSize="20"
                    Text="{Binding StudentSummary, Mode=OneWay}"
                    TextColor="{AppThemeBinding Light=Red, Dark=LightCoral}">

                    <Label.Triggers>
                        <DataTrigger
                            Binding="{Binding IsHighScore}"
                            TargetType="Label"
                            Value="True">

                            <Setter
                                Property="TextColor"
                                Value="{AppThemeBinding Light=Green, Dark=LightGreen}" />

                        </DataTrigger>
                    </Label.Triggers>

                </Label>
            </Border>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
