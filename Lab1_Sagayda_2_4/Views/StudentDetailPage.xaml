<?xml version="1.0" encoding="utf-8" ?>

<ContentPage
    x:Class="Lab1_Sagayda_2_4.Views.StudentDetailPage"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:viewModels="clr-namespace:Lab1_Sagayda_2_4.ViewModels"
    x:DataType="viewModels:StudentDetailViewModel"
    Title="Деталі студента">

    <ScrollView>
        <VerticalStackLayout
            Padding="30"
            Spacing="18">

            <Label
                FontAttributes="Bold"
                FontSize="26"
                Text="Деталі студента" />

            <ActivityIndicator IsRunning="{Binding IsBusy}" IsVisible="{Binding IsBusy}" />
            <Label
                Text="{Binding ErrorMessage}"
                IsVisible="{Binding HasError}"
                TextColor="{AppThemeBinding Light=Red, Dark=LightCoral}" />

            <Label Text="ПІБ студента" />
            <Label Text="{Binding FullName}" />

            <Label Text="Ідентифікатор студента" />
            <Label Text="{Binding StudentId}" LineBreakMode="CharacterWrap" />

            <Label Text="Посилання на студента (Android)" />
            <Label Text="{Binding StudentLink}" LineBreakMode="CharacterWrap" />
            <Button Command="{Binding CopyLinkCommand}" Text="Скопіювати посилання" />

            <Label Text="Група" />
            <Label Text="{Binding Group}" />

            <Label Text="Номер студентського квитка" />
            <Entry
                Text="{Binding StudentCardNumber, Mode=TwoWay}"
                IsReadOnly="{Binding IsBusy}"
                MaxLength="64"
                Placeholder="Необов’язкове поле" />

            <Label Text="Середній бал" />
            <Label Text="{Binding AverageScore, StringFormat='{0:F2}'}" />

            <HorizontalStackLayout Spacing="12">
                <Button
                    Text="−"
                    FontSize="24"
                    WidthRequest="56"
                    Command="{Binding DecreaseScoreCommand}"
                    SemanticProperties.Description="Зменшити середній бал на 0,1" />
                <Button
                    Text="+"
                    FontSize="24"
                    WidthRequest="56"
                    Command="{Binding IncreaseScoreCommand}"
                    SemanticProperties.Description="Збільшити середній бал на 0,1" />
            </HorizontalStackLayout>

            <Button
                Command="{Binding SaveCommand}"
                Text="Зберегти" />

            <Button
                Command="{Binding GoBackCommand}"
                Text="Назад" />

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>
